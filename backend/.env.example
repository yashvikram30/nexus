PORT=
MONGO_URL=
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Required for the folder agent (Ask / Summarize / Compare). Create one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b
GROQ_MODEL=
# Optional. Characters of saved text sent to the model per run (default 20000). Raise it if your Groq plan allows more tokens per minute
AGENT_CONTEXT_CHARS=
# Recommended in production: the site(s) allowed to call this API, e.g. https://nexus.vercel.app (comma separated for several)
CLIENT_URL=
# Optional. Set to 1.1.1.1,8.8.8.8 if you get "querySrv EREFUSED" connecting to MongoDB Atlas
DNS_SERVERS=
